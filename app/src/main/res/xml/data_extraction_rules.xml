<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for API 31+. The login token must not be restored onto another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
