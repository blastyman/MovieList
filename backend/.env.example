# Copy to .env (never commit .env). Every value has a dev default except in production.
APP_ENV=development
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/movielist
DB_USER=movielist
DB_PASSWORD=movielist
# generate with: openssl rand -base64 48
JWT_SECRET=change-me
# TMDB "API Read Access Token" (v4) — https://www.themoviedb.org/settings/api
TMDB_TOKEN=
